#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: script/link-dotfiles [--dry-run] [--force] [--yes]

Creates symlinks from this repo into your $HOME, prefixing filenames with ".".
Files under config/ map to ~/.config/ with the same relative path
(e.g. config/nix/nix.conf -> ~/.config/nix/nix.conf). On macOS, pnpm
reads ~/Library/Preferences/pnpm/config.yaml rather than ~/.config/pnpm.

Modes:
  --dry-run  (default) report what every entry would do, without touching
             anything. Prints a diff for each destination whose contents
             differ from the repo copy.
  --force    apply the plan. A destination that is byte-identical to the repo
             is linked without asking; one that differs is shown as a diff and
             confirmed individually, so machine-specific edits are never lost
             to a blanket run.
  --yes      answer yes to those confirmations (unattended overwrite).

Replaced files are moved aside as <dest>.bak.<timestamp>; nothing is deleted.
With no terminal on stdin, differing destinations are skipped instead of
overwritten -- run it from a shell to review them.

Examples:
  script/link-dotfiles --dry-run
  script/link-dotfiles --force
EOF
}

DRY_RUN=1
ASSUME_YES=0

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --force) DRY_RUN=0 ;;
    -y | --yes) ASSUME_YES=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
stamp=$(date +%Y%m%d%H%M%S)

n_ok=0
n_link=0
n_skip=0
n_missing=0

run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '    [dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

show_diff() {
  dest="$1"
  src="$2"
  printf '    ---- %s (yours) vs repo ----\n' "$dest"
  diff -u "$dest" "$src" | sed 's/^/    /' || true
  printf '    ---- end diff ----\n'
}

confirm() {
  if [ "$ASSUME_YES" -eq 1 ]; then
    return 0
  fi
  printf '    replace %s? [y/N] ' "$1"
  reply=''
  read -r reply || return 1
  case "$reply" in
    [yY] | [yY][eE][sS]) return 0 ;;
    *) return 1 ;;
  esac
}

apply_link() {
  src="$1"
  dest="$2"

  if [ -e "$dest" ] || [ -L "$dest" ]; then
    run mv "$dest" "$dest.bak.$stamp"
  fi

  dest_dir=$(dirname -- "$dest")
  if [ ! -d "$dest_dir" ]; then
    run mkdir -p "$dest_dir"
  fi

  run ln -s "$src" "$dest"
}

ensure_private_gitconfig() {
  private="$HOME/.gitconfig.private"
  if [ -e "$private" ]; then
    return 0
  fi
  run touch "$private"
  if [ "$DRY_RUN" -eq 0 ]; then
    chmod 600 "$private" || true
  fi
}

link_path() {
  src="$1"
  dest="$2"

  if [ ! -e "$src" ]; then
    printf 'MISSING  %s is not in the repo\n' "$src" >&2
    n_missing=$((n_missing + 1))
    return 0
  fi

  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    printf 'ok       %s -> %s\n' "$dest" "$src"
    n_ok=$((n_ok + 1))
    return 0
  fi

  if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
    printf 'link     %s (nothing there yet)\n' "$dest"
    apply_link "$src" "$dest"
    n_link=$((n_link + 1))
    return 0
  fi

  if [ ! -L "$dest" ] && diff -q "$dest" "$src" >/dev/null 2>&1; then
    printf 'link     %s (identical to the repo, nothing to lose)\n' "$dest"
    apply_link "$src" "$dest"
    n_link=$((n_link + 1))
    return 0
  fi

  # Either a copy carrying local edits or a symlink to somewhere else. Those
  # edits may be machine-specific (identity, credentials, host paths), so this
  # is the one case that never gets replaced without the diff being seen.
  if [ -L "$dest" ]; then
    printf 'REVIEW   %s -> %s (points somewhere else)\n' "$dest" "$(readlink "$dest")"
  else
    printf 'REVIEW   %s (local edits are not in the repo)\n' "$dest"
  fi
  show_diff "$dest" "$src"

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '    --force would ask before replacing this one\n'
    n_skip=$((n_skip + 1))
    return 0
  fi

  if [ "$ASSUME_YES" -eq 0 ] && [ ! -t 0 ]; then
    printf '    skipped: no terminal to confirm on (--yes overrides)\n'
    n_skip=$((n_skip + 1))
    return 0
  fi

  if confirm "$dest"; then
    apply_link "$src" "$dest"
    n_link=$((n_link + 1))
  else
    printf '    skipped: %s left as it is\n' "$dest"
    n_skip=$((n_skip + 1))
  fi
}

link_one() {
  link_path "$repo_root/$1" "$HOME/.$1"
}

link_config_one() {
  link_path "$repo_root/config/$1" "$HOME/.config/$1"
}

# pnpm uses env-paths: macOS -> ~/Library/Preferences/pnpm, else ~/.config/pnpm.
link_pnpm_one() {
  case "$(uname -s)" in
    Darwin) dest="$HOME/Library/Preferences/pnpm/config.yaml" ;;
    *) dest="$HOME/.config/pnpm/config.yaml" ;;
  esac
  link_path "$repo_root/config/pnpm/config.yaml" "$dest"
}

ensure_private_gitconfig

for f in \
  zshrc \
  zshenv \
  p10k.zsh \
  tmux.conf \
  gitconfig \
  gitignore \
  gitmessage \
  ripgreprc \
  npmrc \
  bunfig.toml; do
  link_one "$f"
done

for f in \
  nix/nix.conf \
  uv/uv.toml; do
  link_config_one "$f"
done

link_pnpm_one

if [ "$DRY_RUN" -eq 1 ]; then
  printf '\nDry run: %d already linked, %d would be linked, %d need review.\n' \
    "$n_ok" "$n_link" "$n_skip"
  printf 'Re-run with --force to apply.\n'
else
  printf '\nDone: %d already linked, %d linked, %d left alone.\n' \
    "$n_ok" "$n_link" "$n_skip"
fi

if [ "$n_missing" -gt 0 ]; then
  printf '%d source file(s) missing from the repo.\n' "$n_missing" >&2
  exit 1
fi
